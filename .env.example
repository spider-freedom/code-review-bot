# ============================================
# Code Review Bot — 环境变量模板
# 复制为 .env 并填入真实值
# ============================================

# DeepSeek AI API Key (必填)
# 获取: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-api-key-here

# MySQL (Docker Compose 默认值即可)
DB_URL=jdbc:mysql://localhost:3306/code_review_bot?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=root

# Redis (Docker Compose 默认值即可)
REDIS_HOST=localhost
REDIS_PORT=6379
